<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 and later: the photo is the background layer, which each phone
     trims to its own shape (circle, squircle...). The dev and staging flavors
     swap in their own labelled backgrounds from src/dev and src/staging. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
