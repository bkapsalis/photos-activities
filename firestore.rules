rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Photos ─────────────────────────────────────────
    // Anyone can browse photos. Authenticated users can create, update, or delete.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Locations ──────────────────────────────────────
    match /locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Chat Messages (Location Chat) ──────────────────
    match /chats/{locationId}/messages/{messageId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // ── Comments (Picture Chat) ────────────────────────
    match /comments/{photoId}/messages/{commentId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }
  }
}
