rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Photos ─────────────────────────────────────────
    match /photos/{photoId} {
      allow read, write: if true;
    }

    // ── Locations ──────────────────────────────────────
    match /locations/{locationId} {
      allow read, write: if true;
    }

    // ── Chat Messages (Location Chat) ──────────────────
    match /chats/{locationId}/messages/{messageId} {
      allow read, write: if true;
    }

    // ── Comments (Picture Chat) ────────────────────────
    match /comments/{photoId}/messages/{commentId} {
      allow read, write: if true;
    }

    // ── Collection group over every "messages" subcollection ──
    // The path rules above do not apply to collectionGroup queries; only a
    // recursive wildcard does. Deliberately scoped to the caller's own
    // messages, so this permits counting and renaming what you wrote and
    // nothing else.
    match /{path=**}/messages/{messageId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
    }
  }
}
