rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Photos ─────────────────────────────────────────
    // Anyone can browse photos. Only authenticated users can create.
    // Only the photo owner can update or delete.
    match /photos/{photoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && (request.auth.uid == resource.data.userId
                        || request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['heartCount']));
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
    }

    // ── Locations ──────────────────────────────────────
    match /locations/{locationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Chat Messages (Location Chat) ──────────────────
    match /chats/{locationId}/messages/{messageId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.userId;
    }

    // ── Comments (Picture Chat) ────────────────────────
    match /comments/{photoId}/messages/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                             && request.auth.uid == resource.data.userId;
    }
  }
}
