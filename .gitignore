# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material and local secrets — these belong in Codemagic environment
# groups (android_signing / ios_signing / play_store / app_store), never here.
#
# Note: google-services.json, GoogleService-Info.plist and firebase_options_*.dart
# are deliberately NOT ignored. They are client configuration, not secrets —
# access is gated by Firestore rules and API key restrictions.
**/android/key.properties
**/*.jks
**/*.keystore
*.p8
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
**/ios/ExportOptions.plist
.env
.env.*
!.env.example

# Google Maps API key (iOS)
ios/Flutter/Maps.xcconfig

# Build output. The existing /build/ rule is root-anchored and misses this one.
**/build/

# Editor-local settings
.vscode/

# Working copies left by scripted edits to Xcode/plist files
*.bak
*.bak2

# Local safety copies of Firestore documents taken before bulk edits.
# Operational records, not source.
firestore-backup-*/
firestore-seed-backup-*/

# Scratch file from an unrelated project
/TEMP

# Rules test dependencies (test/rules)
node_modules/
