rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Photos ─────────────────────────────────────────
    // Anyone can view photos. Only authenticated users can upload.
    // Max file size: 10MB. Must be an image.
    match /photos/{category}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
